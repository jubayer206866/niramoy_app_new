{
  "name": "niramoy-pharmacy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "scrape": "node scripts/scrape-arogga.mjs",
    "scrape:quick": "node scripts/scrape-arogga.mjs --quick",
    "db:build": "node scripts/build-db.mjs",
    "db:mysql-import": "node scripts/sqlite-to-mysql.mjs",
    "db:link-images": "node scripts/link-images.mjs",
    "scrape:full": "node scripts/scrape-full.mjs",
    "db:merge": "node scripts/merge-full.mjs",
    "db:images": "node scripts/download-images.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "harvest": "node scripts/scrape-full.mjs --time-budget 5400 --max-pages 25000 && node scripts/merge-full.mjs && node scripts/download-images.mjs && node scripts/build-db.mjs && node scripts/sqlite-to-mysql.mjs --catalogue",
    "server": "node server/index.mjs",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run dev\"",
    "start": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "mysql2": "^3.24.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^11.3.0",
    "concurrently": "^9.0.1",
    "express": "^4.21.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
